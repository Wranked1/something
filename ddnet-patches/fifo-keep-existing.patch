From db89c7411dd5e3391da0ded38891014418c9e213 Mon Sep 17 00:00:00 2001
From: Wranked1 <129415993+Wranked1@users.noreply.github.com>
Date: Thu, 24 Sep 2026 11:01:11 +0000
Subject: [PATCH] Fix existing input fifo being removed and recreated

An existing fifo at the `sv_input_fifo`/`cl_input_fifo` path was always
removed and recreated with the misleading warning "File '...' is not a
fifo, removing", because `mkfifo` failing with `EEXIST` was handled like
the file not being a fifo. Writers that opened the fifo before the
server or client started were left waiting on the removed fifo forever,
so their commands were never executed.

Check whether the existing file is a fifo instead and only replace it
if it is not, like before.

Regression from #11470.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01E3rsC3FRVop9j9KaM9zRGS
---
 CMakeLists.txt             |  1 +
 src/engine/shared/fifo.cpp |  2 +-
 src/test/fifo_test.cpp     | 55 ++++++++++++++++++++++++++++++++++++++
 3 files changed, 57 insertions(+), 1 deletion(-)
 create mode 100644 src/test/fifo_test.cpp

diff --git a/CMakeLists.txt b/CMakeLists.txt
index d920c9e26..ed38c1e0e 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -3454,6 +3454,7 @@ if((GTEST_FOUND OR DOWNLOAD_GTEST) AND SERVER)
     datafile_test.cpp
     dbg_test.cpp
     editor_test.cpp
+    fifo_test.cpp
     fs_test.cpp
     gameworld_test.cpp
     git_revision_test.cpp
diff --git a/src/engine/shared/fifo.cpp b/src/engine/shared/fifo.cpp
index 0b65e6522..325288d1b 100644
--- a/src/engine/shared/fifo.cpp
+++ b/src/engine/shared/fifo.cpp
@@ -26,7 +26,7 @@ void CFifo::Init(IConsole *pConsole, const char *pFifoFile, int Flag)
 	m_Flag = Flag;
 
 	bool IsFifo;
-	if(mkfifo(m_aFilename, 0600) == 0)
+	if(mkfifo(m_aFilename, 0600) == 0 || errno == EEXIST)
 	{
 		struct stat Attribute;
 		if(stat(m_aFilename, &Attribute) == 0)
diff --git a/src/test/fifo_test.cpp b/src/test/fifo_test.cpp
new file mode 100644
index 000000000..63a1812fb
--- /dev/null
+++ b/src/test/fifo_test.cpp
@@ -0,0 +1,55 @@
+#include "test.h"
+
+#include <base/detect.h>
+
+#if defined(CONF_FAMILY_UNIX)
+#include <base/io.h>
+
+#include <engine/shared/config.h>
+#include <engine/shared/fifo.h>
+
+#include <fcntl.h>
+#include <gtest/gtest.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+TEST(Fifo, KeepExistingFifo)
+{
+	CTestInfo Info;
+	ASSERT_EQ(mkfifo(Info.m_aFilename, 0600), 0);
+	// Keep the existing fifo open, like a process that writes commands to it
+	const int ExistingFifo = open(Info.m_aFilename, O_RDONLY | O_NONBLOCK);
+	ASSERT_GE(ExistingFifo, 0);
+
+	CFifo Fifo;
+	Fifo.Init(nullptr, Info.m_aFilename, CFGFLAG_SERVER);
+
+	struct stat Existing;
+	ASSERT_EQ(fstat(ExistingFifo, &Existing), 0);
+	struct stat Current;
+	ASSERT_EQ(stat(Info.m_aFilename, &Current), 0);
+	EXPECT_TRUE(S_ISFIFO(Current.st_mode));
+	EXPECT_EQ(Existing.st_dev, Current.st_dev);
+	EXPECT_EQ(Existing.st_ino, Current.st_ino);
+
+	Fifo.Shutdown();
+	close(ExistingFifo);
+}
+
+TEST(Fifo, ReplaceNonFifoFile)
+{
+	CTestInfo Info;
+	IOHANDLE File = io_open(Info.m_aFilename, IOFLAG_WRITE);
+	ASSERT_TRUE(File);
+	EXPECT_FALSE(io_close(File));
+
+	CFifo Fifo;
+	Fifo.Init(nullptr, Info.m_aFilename, CFGFLAG_SERVER);
+
+	struct stat Attribute;
+	ASSERT_EQ(stat(Info.m_aFilename, &Attribute), 0);
+	EXPECT_TRUE(S_ISFIFO(Attribute.st_mode));
+
+	Fifo.Shutdown();
+}
+#endif
