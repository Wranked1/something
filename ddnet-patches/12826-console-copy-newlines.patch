From 7989aad0cd46d987486bf105c6502d6e73257774 Mon Sep 17 00:00:00 2001
From: wranked1 <wranked.1@gmail.com>
Date: Thu, 24 Sep 2026 10:02:08 +0000
Subject: [PATCH] Fix selecting and copying text of multi-line console entries

Copying a selection with Ctrl+C from a console entry that contains line
breaks, such as multi-line rcon output, put different text into the
clipboard than what was highlighted. The copied range was shifted back
by one character for every line break before it, e.g. selecting
`5555555555` copied `4444444455`, and the last characters of such an
entry, like a final `)`, could never be copied. Dragging the mouse to
the right of the last character of such a line also did not select up
to the end of the line. This only worked on the last line of an entry.

Since ea058d9d2 ("Replace `CharacterCounter` with existing
`pCursor->m_GlyphCount`") the text renderer reports the selection as
glyph offsets, which do not include line breaks, but the console
converts them to byte offsets with `str_utf8_offset_chars_to_bytes`,
which counts every character including line breaks. When calculating
the selection, the text renderer also only compares the mouse positions
with the glyphs and with the end of the whole text, but not with the
end of a line that is followed by a line break.

Convert the selection offsets by skipping line breaks like the text
renderer does. Line breaks directly before the first selected glyph are
skipped, so the copied text does not start with a line break, while
line breaks inside the selection are kept. The text renderer now also
checks the mouse positions against the end of each line before a line
break, like it already does at the end of the text. Also correct the
comment on the selection offsets in `CTextCursor`.

Closes #12826.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01E3rsC3FRVop9j9KaM9zRGS
---
 src/engine/client/text.cpp             |  8 ++++++++
 src/engine/textrender.h                |  2 +-
 src/game/client/components/console.cpp | 22 ++++++++++++++++++++--
 3 files changed, 29 insertions(+), 3 deletions(-)

diff --git a/src/engine/client/text.cpp b/src/engine/client/text.cpp
index 5c16db89c..e95a70829 100644
--- a/src/engine/client/text.cpp
+++ b/src/engine/client/text.cpp
@@ -1710,6 +1710,14 @@ public:
 				{
 					if((pCursor->m_Flags & TEXTFLAG_DISALLOW_NEWLINE) == 0)
 					{
+						if(pCursor->m_CalculateSelectionMode == TEXT_CURSOR_SELECTION_MODE_CALCULATE)
+						{
+							// the mouse can also be to the right of the last character of the line
+							CheckSelectionStart(false, pCursor->m_PressMouse, SelectionStartChar, SelectionUsedPress, LastCharX, LastCharWidth, std::numeric_limits<float>::max(), 0, DrawY + pCursor->m_AlignedFontSize);
+							CheckSelectionStart(false, pCursor->m_ReleaseMouse, SelectionEndChar, SelectionUsedRelease, LastCharX, LastCharWidth, std::numeric_limits<float>::max(), 0, DrawY + pCursor->m_AlignedFontSize);
+							CheckSelectionEnd(false, pCursor->m_ReleaseMouse, SelectionEndChar, SelectionUsedRelease, std::numeric_limits<float>::max(), 0, DrawY + pCursor->m_AlignedFontSize);
+							CheckSelectionEnd(false, pCursor->m_PressMouse, SelectionStartChar, SelectionUsedPress, std::numeric_limits<float>::max(), 0, DrawY + pCursor->m_AlignedFontSize);
+						}
 						if(StartNewLine())
 						{
 							pLastGlyph = nullptr;
diff --git a/src/engine/textrender.h b/src/engine/textrender.h
index e89a87694..0456133d5 100644
--- a/src/engine/textrender.h
+++ b/src/engine/textrender.h
@@ -143,7 +143,7 @@ public:
 	vec2 m_ReleaseMouse = vec2(0.0f, 0.0f);
 
 	// note m_SelectionStart can be bigger than m_SelectionEnd, depending on how the mouse cursor was dragged
-	// also note, that these are the character offsets decoded
+	// also note, that these are the character offsets decoded, not counting line breaks
 	int m_SelectionStart = 0;
 	int m_SelectionEnd = 0;
 
diff --git a/src/game/client/components/console.cpp b/src/game/client/components/console.cpp
index 77e21c6f6..aed321ec5 100644
--- a/src/game/client/components/console.cpp
+++ b/src/game/client/components/console.cpp
@@ -1048,6 +1048,21 @@ int CGameConsole::PossibleMaps(const char *pStr, IConsole::FPossibleCallback pfn
 	return Index;
 }
 
+// converts a glyph offset of the text renderer's selection to a byte offset,
+// line breaks must not be counted because they are not rendered as glyphs
+static int GlyphOffsetToBytes(const char *pStr, int GlyphOffset)
+{
+	int ByteOffset = 0;
+	int GlyphCount = 0;
+	while(GlyphCount < GlyphOffset && pStr[ByteOffset] != '\0')
+	{
+		if(pStr[ByteOffset] != '\n')
+			GlyphCount++;
+		ByteOffset = str_utf8_forward(pStr, ByteOffset);
+	}
+	return ByteOffset;
+}
+
 // only defined for 0<=t<=1
 static float ConsoleScaleFunc(float t)
 {
@@ -1568,8 +1583,11 @@ void CGameConsole::OnRender()
 				if(m_WantsSelectionCopy)
 				{
 					const bool HasNewLine = !SelectionString.empty();
-					const size_t OffUTF8Start = str_utf8_offset_chars_to_bytes(pEntry->m_aText, pConsole->m_CurSelStart);
-					const size_t OffUTF8End = str_utf8_offset_chars_to_bytes(pEntry->m_aText, pConsole->m_CurSelEnd);
+					size_t OffUTF8Start = GlyphOffsetToBytes(pEntry->m_aText, pConsole->m_CurSelStart);
+					// the first selected glyph comes after the line breaks at this offset
+					while(pEntry->m_aText[OffUTF8Start] == '\n')
+						OffUTF8Start++;
+					const size_t OffUTF8End = GlyphOffsetToBytes(pEntry->m_aText, pConsole->m_CurSelEnd);
 					SelectionString.insert(0, (std::string(&pEntry->m_aText[OffUTF8Start], OffUTF8End - OffUTF8Start) + (HasNewLine ? "\n" : "")));
 				}
 				pConsole->m_HasSelection = true;
