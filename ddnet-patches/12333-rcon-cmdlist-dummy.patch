From bd9fcfd952eb5eceb65317ef64b54972b452d990 Mon Sep 17 00:00:00 2001
From: wranked1 <wranked.1@gmail.com>
Date: Thu, 24 Sep 2026 09:59:25 +0000
Subject: [PATCH] Fix dummy rcon console suggesting wrong commands after main
 logout

When the main connection logged out of rcon while the dummy stayed
logged in, the dummy's remote console suggested the client's built-in
list of server commands and settings (e.g. every sv_* setting) instead
of the commands the server allows. For a moderator this looked like
admin-only commands were leaked, although the names only came from the
client itself.

Since eff9abf76 ("Fix logging into rcon with dummy") the client tracks
the rcon login state of each connection, but whether the server sends
its own command list was still only stored for the main connection.
After the main connection logged out, the console saw a logged in dummy
without a server command list and fell back to the built-in list, which
is only meant for servers that do not send one.

Store whether the server sends a command list per connection, like the
login state. The client still only uses the command list sent to the
main connection, so in this case the dummy console now shows no command
suggestions instead of the misleading built-in list.

Closes #12333.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01E3rsC3FRVop9j9KaM9zRGS
---
 src/engine/client/client.cpp | 19 +++++++++++--------
 src/engine/client/client.h   |  4 ++--
 2 files changed, 13 insertions(+), 10 deletions(-)

diff --git a/src/engine/client/client.cpp b/src/engine/client/client.cpp
index 3bcef2ccb..41fa7a31b 100644
--- a/src/engine/client/client.cpp
+++ b/src/engine/client/client.cpp
@@ -757,7 +757,7 @@ void CClient::DisconnectWithReason(const char *pReason)
 	mem_zero(m_aRconPassword, sizeof(m_aRconPassword));
 	m_MapDetails = std::nullopt;
 	m_ServerSentCapabilities = false;
-	m_UseTempRconCommands = 0;
+	m_aUseTempRconCommands[0] = 0;
 	m_ExpectedRconCommands = -1;
 	m_GotRconCommands = 0;
 	m_pConsole->DeregisterTempAll();
@@ -846,6 +846,7 @@ void CClient::DummyConnect()
 
 	m_LastDummyConnectTime = GlobalTime();
 	m_aRconAuthed[1] = 0;
+	m_aUseTempRconCommands[1] = 0;
 	m_DummySendConnInfo = true;
 
 	g_Config.m_ClDummyCopyMoves = 0;
@@ -868,6 +869,7 @@ void CClient::DummyDisconnect(const char *pReason)
 	g_Config.m_ClDummy = 0;
 
 	m_aRconAuthed[1] = 0;
+	m_aUseTempRconCommands[1] = 0;
 	m_aapSnapshots[1][SNAP_CURRENT] = nullptr;
 	m_aapSnapshots[1][SNAP_PREV] = nullptr;
 	m_aReceivedSnapshots[1] = 0;
@@ -2049,15 +2051,16 @@ void CClient::ProcessServerPacket(CNetChunk *pPacket, int Conn, bool Dummy)
 				if(m_aRconAuthed[Conn])
 					RconAuth(m_aRconUsername, m_aRconPassword, g_Config.m_ClDummy ^ 1);
 			}
+			const int Old = m_aUseTempRconCommands[Conn];
+			m_aUseTempRconCommands[Conn] = Unpacker.GetInt();
+			if(Unpacker.Error())
+			{
+				m_aUseTempRconCommands[Conn] = 0;
+			}
+			// The rcon commands and maplist are only handled for the main connection
 			if(Conn == CONN_MAIN)
 			{
-				int Old = m_UseTempRconCommands;
-				m_UseTempRconCommands = Unpacker.GetInt();
-				if(Unpacker.Error())
-				{
-					m_UseTempRconCommands = 0;
-				}
-				if(Old != 0 && m_UseTempRconCommands == 0)
+				if(Old != 0 && m_aUseTempRconCommands[Conn] == 0)
 				{
 					m_pConsole->DeregisterTempAll();
 					m_ExpectedRconCommands = -1;
diff --git a/src/engine/client/client.h b/src/engine/client/client.h
index bee23079b..8cab667d2 100644
--- a/src/engine/client/client.h
+++ b/src/engine/client/client.h
@@ -116,7 +116,7 @@ class CClient : public IClient, public CDemoPlayer::IListener
 	int m_aRconAuthed[NUM_DUMMIES] = {0, 0};
 	char m_aRconUsername[64] = "";
 	char m_aRconPassword[sizeof(g_Config.m_SvRconPassword)] = "";
-	int m_UseTempRconCommands = 0;
+	int m_aUseTempRconCommands[NUM_DUMMIES] = {0, 0};
 	int m_ExpectedRconCommands = -1;
 	int m_GotRconCommands = 0;
 	char m_aPassword[sizeof(g_Config.m_Password)] = "";
@@ -308,7 +308,7 @@ public:
 	void SendMapRequest();
 
 	bool RconAuthed() const override { return m_aRconAuthed[g_Config.m_ClDummy] != 0; }
-	bool UseTempRconCommands() const override { return m_UseTempRconCommands != 0; }
+	bool UseTempRconCommands() const override { return m_aUseTempRconCommands[g_Config.m_ClDummy] != 0; }
 	void RconAuth(const char *pName, const char *pPassword, bool Dummy = g_Config.m_ClDummy) override;
 	void Rcon(const char *pCmd) override;
 	bool ReceivingRconCommands() const override { return m_ExpectedRconCommands > 0; }
