From cf3ec27a40cd5c786e28ddcd337a6ec8300c6cbf Mon Sep 17 00:00:00 2001
From: Wranked1 <129415993+Wranked1@users.noreply.github.com>
Date: Thu, 24 Sep 2026 11:01:11 +0000
Subject: [PATCH] Fix undefined behavior in HUD when seeking in demos

When seeking in a demo, the HUD received an infinite intra tick and
converted it to an integer while interpolating the velocity of the
local or spectated tee, which is undefined behavior (reported by UBSan
in `mix` called from `CHud::OnNewSnapshot`).

When seeking has to restart playback from a keyframe, the demo player
resets the previous and current tick to -1. The first `DoTick`
afterwards calls `UpdateTimes`, which divided by the duration between
the previous and current tick, i.e. by zero. While reading the
keyframe's tick marker, `DoTick` replays the last snapshot from before
the seek to the listeners, so the client processed this snapshot with
the infinite intra tick. The intra tick calculation was added to
`DoTick` in 91b60e698 ("Make emoticons smoother").

Use an intra tick of 0 when the duration between the previous and
current tick is not positive. Add a test that records a demo, seeks in
it and checks that the listener only sees finite intra ticks.

Closes #11354.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01E3rsC3FRVop9j9KaM9zRGS
---
 CMakeLists.txt             |  1 +
 src/engine/shared/demo.cpp |  4 +-
 src/test/demo_test.cpp     | 80 ++++++++++++++++++++++++++++++++++++++
 3 files changed, 84 insertions(+), 1 deletion(-)
 create mode 100644 src/test/demo_test.cpp

diff --git a/CMakeLists.txt b/CMakeLists.txt
index d920c9e26..d60bc9322 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -3453,6 +3453,7 @@ if((GTEST_FOUND OR DOWNLOAD_GTEST) AND SERVER)
     csv_test.cpp
     datafile_test.cpp
     dbg_test.cpp
+    demo_test.cpp
     editor_test.cpp
     fs_test.cpp
     gameworld_test.cpp
diff --git a/src/engine/shared/demo.cpp b/src/engine/shared/demo.cpp
index 256a30e0a..a7beb5a80 100644
--- a/src/engine/shared/demo.cpp
+++ b/src/engine/shared/demo.cpp
@@ -1268,7 +1268,9 @@ void CDemoPlayer::UpdateTimes()
 	const int64_t Freq = time_freq();
 	const int64_t CurrentTickStart = m_Info.m_Info.m_CurrentTick * Freq / SERVER_TICK_SPEED;
 	const int64_t PreviousTickStart = m_Info.m_PreviousTick * Freq / SERVER_TICK_SPEED;
-	m_Info.m_IntraTick = (m_Info.m_CurrentTime - PreviousTickStart) / (float)(CurrentTickStart - PreviousTickStart);
+	// Previous and current tick are both -1 when (re)starting playback, e.g. when seeking to a keyframe
+	const int64_t TickDuration = CurrentTickStart - PreviousTickStart;
+	m_Info.m_IntraTick = TickDuration > 0 ? (m_Info.m_CurrentTime - PreviousTickStart) / (float)TickDuration : 0.0f;
 	m_Info.m_IntraTickSincePrev = (m_Info.m_CurrentTime - PreviousTickStart) / (float)(Freq / SERVER_TICK_SPEED);
 	m_Info.m_TickTime = (m_Info.m_CurrentTime - PreviousTickStart) / (float)Freq;
 	m_Info.m_Info.m_LivePlayback = m_Info.m_Info.m_LastTick - m_Info.m_Info.m_CurrentTick < 3 * SERVER_TICK_SPEED;
diff --git a/src/test/demo_test.cpp b/src/test/demo_test.cpp
new file mode 100644
index 000000000..21e1d0488
--- /dev/null
+++ b/src/test/demo_test.cpp
@@ -0,0 +1,80 @@
+#include "test.h"
+
+#include <engine/shared/demo.h>
+#include <engine/shared/network.h>
+#include <engine/shared/protocol.h>
+#include <engine/shared/snapshot.h>
+#include <engine/storage.h>
+
+#include <generated/protocol.h>
+
+#include <game/version.h>
+
+#include <gtest/gtest.h>
+
+#include <cmath>
+#include <memory>
+
+class CIntraTickCheckListener : public CDemoPlayer::IListener
+{
+public:
+	const CDemoPlayer *m_pDemoPlayer = nullptr;
+	int m_NumSnapshots = 0;
+	int m_NumInvalidIntraTicks = 0;
+
+	void OnDemoPlayerSnapshot(void *pData, int Size) override
+	{
+		m_NumSnapshots++;
+		if(!std::isfinite(m_pDemoPlayer->Info()->m_IntraTick))
+		{
+			m_NumInvalidIntraTicks++;
+		}
+	}
+
+	void OnDemoPlayerMessage(void *pData, int Size) override {}
+};
+
+TEST(Demo, SeekIntraTickFinite)
+{
+	CTestInfo Info;
+	Info.m_DeleteTestStorageFilesOnSuccess = true;
+	std::unique_ptr<IStorage> pStorage = Info.CreateTestStorage();
+	ASSERT_NE(pStorage, nullptr) << "Error creating test storage";
+
+	CNetBase::Init();
+	CSnapshotDelta SnapshotDelta;
+	auto pRecorder = std::make_unique<CDemoRecorder>(&SnapshotDelta, true);
+	// non-null so the recorder does not try to open the map file, no map data is recorded
+	unsigned char MapData = 0;
+	ASSERT_EQ(pRecorder->Start(pStorage.get(), nullptr, "test.demo", GAME_NETVERSION, "test", SHA256_DIGEST{}, 0, "client", 0, &MapData, nullptr, nullptr, nullptr), 0);
+	auto pBuilder = std::make_unique<CSnapshotBuilder>();
+	auto pSnapshot = std::make_unique<CSnapshotBuffer>();
+	for(int Tick = 1; Tick <= 20 * SERVER_TICK_SPEED; Tick++)
+	{
+		pBuilder->Init();
+		CNetObj_Flag Flag;
+		Flag.m_X = Tick;
+		Flag.m_Y = 0;
+		Flag.m_Team = 0;
+		EXPECT_TRUE(pBuilder->NewItem(NETOBJTYPE_FLAG, 0, &Flag, sizeof(Flag)));
+		const int SnapshotSize = pBuilder->Finish(pSnapshot.get());
+		pRecorder->RecordSnapshot(Tick, pSnapshot->AsSnapshot(), SnapshotSize);
+	}
+	ASSERT_EQ(pRecorder->Stop(IDemoRecorder::EStopMode::KEEP_FILE), 0);
+
+	auto pPlayer = std::make_unique<CDemoPlayer>(&SnapshotDelta, &SnapshotDelta, false);
+	CIntraTickCheckListener Listener;
+	Listener.m_pDemoPlayer = pPlayer.get();
+	pPlayer->SetListener(&Listener);
+	ASSERT_EQ(pPlayer->Load(pStorage.get(), nullptr, "test.demo", IStorage::TYPE_SAVE), 0);
+	pPlayer->Play();
+	ASSERT_TRUE(pPlayer->IsPlaying());
+
+	// seeking forwards past a keyframe and backwards both restart playback from a keyframe
+	EXPECT_TRUE(pPlayer->SeekPercent(0.8f));
+	EXPECT_TRUE(pPlayer->SeekPercent(0.2f));
+	EXPECT_GT(Listener.m_NumSnapshots, 0);
+	EXPECT_EQ(Listener.m_NumInvalidIntraTicks, 0);
+
+	pPlayer->Stop();
+}
