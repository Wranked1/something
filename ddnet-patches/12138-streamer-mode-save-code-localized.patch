From ad85a99229da325a7f0860399a2fb25dff79ad6c Mon Sep 17 00:00:00 2001
From: Wranked1 <129415993+Wranked1@users.noreply.github.com>
Date: Thu, 24 Sep 2026 11:01:10 +0000
Subject: [PATCH] Fix streamer mode not censoring save codes in other languages

The pending and fallback save messages for the save code net message
are translated, but the streamer mode censoring in the chat only
matched the English messages, so save codes were shown on stream when
another language was used.

Format these messages a second time with censored save codes when the
net message is received and show that text in the chat while streamer
mode is enabled. The console still receives the original message, so
the code stays accessible there. As only the codes are replaced now,
the name of the player who saved and the server name are shown in
streamer mode too.

Closes #12138.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01E3rsC3FRVop9j9KaM9zRGS
---
 src/game/client/components/chat.cpp |  17 ++++-
 src/game/client/components/chat.h   |   6 ++
 src/game/client/gameclient.cpp      | 108 +++++++++++++++-------------
 3 files changed, 82 insertions(+), 49 deletions(-)

diff --git a/src/game/client/components/chat.cpp b/src/game/client/components/chat.cpp
index 24558d380..47159b60c 100644
--- a/src/game/client/components/chat.cpp
+++ b/src/game/client/components/chat.cpp
@@ -42,6 +42,7 @@ void CChat::CLine::Reset(CChat &This)
 	m_Initialized = false;
 	m_Time = 0;
 	m_aText[0] = '\0';
+	m_aStreamerModeText[0] = '\0';
 	m_aName[0] = '\0';
 	m_Friend = false;
 	m_TimesRepeated = 0;
@@ -657,6 +658,11 @@ void CChat::StoreSave(const char *pText)
 }
 
 void CChat::AddLine(int ClientId, int Team, const char *pLine)
+{
+	AddLineWithStreamerModeText(ClientId, Team, pLine, nullptr);
+}
+
+void CChat::AddLineWithStreamerModeText(int ClientId, int Team, const char *pLine, const char *pStreamerModeLine)
 {
 	if(*pLine == 0 ||
 		(ClientId == SERVER_MSG && !g_Config.m_ClShowChatSystem) ||
@@ -798,6 +804,10 @@ void CChat::AddLine(int ClientId, int Team, const char *pLine)
 	CurrentLine.m_Highlighted = Highlighted;
 
 	str_copy(CurrentLine.m_aText, pLine);
+	if(pStreamerModeLine != nullptr)
+	{
+		str_copy(CurrentLine.m_aStreamerModeText, pStreamerModeLine);
+	}
 
 	if(CurrentLine.m_ClientId == SERVER_MSG)
 	{
@@ -977,8 +987,13 @@ void CChat::OnPrepareLines(float y)
 			str_format(aCount, sizeof(aCount), " [%d]", Line.m_TimesRepeated + 1);
 
 		const char *pText = Line.m_aText;
-		if(Config()->m_ClStreamerMode && Line.m_ClientId == SERVER_MSG)
+		if(Config()->m_ClStreamerMode && Line.m_aStreamerModeText[0] != '\0')
+		{
+			pText = Line.m_aStreamerModeText;
+		}
+		else if(Config()->m_ClStreamerMode && Line.m_ClientId == SERVER_MSG)
 		{
+			// Servers without the save code net message send save codes as untranslated chat messages
 			if(str_startswith(Line.m_aText, "Team save in progress. You'll be able to load with '/load ") && str_endswith(Line.m_aText, "'"))
 			{
 				pText = "Team save in progress. You'll be able to load with '/load *** *** ***'";
diff --git a/src/game/client/components/chat.h b/src/game/client/components/chat.h
index 6a8087224..e5ebe0a8d 100644
--- a/src/game/client/components/chat.h
+++ b/src/game/client/components/chat.h
@@ -48,6 +48,7 @@ class CChat : public CComponent
 		int m_NameColor;
 		char m_aName[64];
 		char m_aText[MAX_CHAT_LENGTH];
+		char m_aStreamerModeText[MAX_CHAT_LENGTH];
 		bool m_Friend;
 		bool m_Highlighted;
 		std::optional<ColorRGBA> m_CustomColor;
@@ -167,6 +168,11 @@ public:
 
 	bool IsActive() const { return m_Mode != MODE_NONE; }
 	void AddLine(int ClientId, int Team, const char *pLine);
+	/**
+	 * Adds a line that is rendered as `pStreamerModeLine` instead of `pLine` while streamer mode is enabled,
+	 * unless `pStreamerModeLine` is `nullptr`. The console always receives the original line.
+	 */
+	void AddLineWithStreamerModeText(int ClientId, int Team, const char *pLine, const char *pStreamerModeLine);
 	void EnableMode(int Team);
 	void DisableMode();
 	void RegisterCommand(const char *pName, const char *pParams, const char *pHelpText);
